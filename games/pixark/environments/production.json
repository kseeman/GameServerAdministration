{
  "metadata": {
    "environment": "production",
    "description": "Production environment configuration for PixARK servers",
    "version": "1.0",
    "created": "2026-04-20T00:00:00Z"
  },
  "game": {
    "name": "PixARK",
    "docker_image": "pixark-server:latest",
    "data_volume_path": "/home/steam/PixARK-dedicated/ShooterGame/Saved",
    "config_files": ["GameUserSettings.ini", "Game.ini"],
    "backup_includes": ["."],
    "update_on_boot": true,
    "health_check": {
      "type": "container",
      "port": "game_port"
    }
  },
  "server_infrastructure": {
    "base_server_name": "Vauld's PixARK",
    "server_description_suffix": "",
    "admin_password": "",
    "base_password": "",
    "sft_user": "pixark",
    "sft_pass": "",
    "sft_port_base": 2222
  },
  "network_config": {
    "base_ports": {
      "game_port": 27015,
      "query_port": 27016,
      "rcon_port": 27017,
      "restapi_port": 27018
    },
    "port_offset_per_instance": 10,
    "public_ip": "",
    "region": "US",
    "rcon_enabled": true
  },
  "docker_config": {
    "restart_policy": "unless-stopped",
    "memory_limit": "16g",
    "cpu_limit": "4"
  },
  "naming_conventions": {
    "volume_pattern": "pixark-vol-production-{instance}",
    "container_pattern": "pixark-production-{instance}",
    "backup_pattern": "{preset}_{instance}_production_{timestamp}.tar.gz"
  },
  "backup_config": {
    "backup_retention": 48,
    "backup_schedule": "0 */2 * * *",
    "backup_location": "./backups/production/{instance}/"
  },
  "instances": {
    "main": {
      "description": "Main PixARK Server",
      "default_preset": "default",
      "port_offset": 0,
      "max_players": 8,
      "map": "CubeWorld_Light",
      "cube_world": "cubeworld",
      "map_seed": "",
      "alt_save_dir": "",
      "cluster_id": ""
    },
    "terracrypt": {
      "description": "Terracrypt",
      "default_preset": "default",
      "port_offset": 1,
      "max_players": 8,
      "map": "Underground_Light",
      "cube_world": "cubeworld",
      "map_seed": "",
      "alt_save_dir": "",
      "cluster_id": ""
    }
  }
}
