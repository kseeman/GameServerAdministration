{
  "metadata": {
    "environment": "staging",
    "description": "Staging environment configuration for PixARK servers",
    "version": "1.0",
    "created": "2026-04-20T00:00:00Z"
  },
  "game": {
    "name": "PixARK",
    "docker_image": "pixark-server:latest",
    "data_volume_path": "/home/steam/PixARK-dedicated/ShooterGame/Saved",
    "config_files": ["GameUserSettings.ini", "Game.ini"],
    "backup_includes": ["."],
    "update_on_boot": true,
    "health_check": {
      "type": "container",
      "port": "game_port"
    }
  },
  "server_infrastructure": {
    "base_server_name": "Vauld's PixARK (Staging)",
    "server_description_suffix": "Staging Environment - Testing Only",
    "admin_password": "",
    "base_password": "",
    "sft_user": "pixark",
    "sft_pass": "",
    "sft_port_base": 2322
  },
  "network_config": {
    "base_ports": {
      "game_port": 47015,
      "query_port": 47016,
      "rcon_port": 47017,
      "restapi_port": 47018
    },
    "port_offset_per_instance": 10,
    "public_ip": "",
    "region": "US",
    "rcon_enabled": true
  },
  "docker_config": {
    "restart_policy": "unless-stopped",
    "memory_limit": "8g",
    "cpu_limit": "2"
  },
  "naming_conventions": {
    "volume_pattern": "pixark-vol-staging-{instance}",
    "container_pattern": "pixark-staging-{instance}",
    "backup_pattern": "{preset}_{instance}_staging_{timestamp}.tar.gz"
  },
  "backup_config": {
    "backup_retention": 5,
    "backup_schedule": "0 */4 * * *",
    "backup_location": "./backups/staging/{instance}/"
  },
  "instances": {
    "test": {
      "description": "Testing server instance",
      "default_preset": "default",
      "port_offset": 0,
      "max_players": 4,
      "map": "CubeWorld_Light",
      "cube_world": "cubeworld",
      "map_seed": "",
      "alt_save_dir": "",
      "cluster_id": ""
    },
    "terracrypt": {
      "description": "Terracrypt (Underground) expansion server",
      "default_preset": "default",
      "port_offset": 1,
      "max_players": 4,
      "map": "Underground_Light",
      "cube_world": "cubeworld",
      "map_seed": "",
      "alt_save_dir": "",
      "cluster_id": ""
    }
  }
}
