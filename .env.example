# Secrets for game server environments. Copy this file to `.env` at the repo
# root and fill in the values for any (game, environment) you actually run.
# `.env` is gitignored; never commit it.
#
# Naming convention: {GAME}_{ENVIRONMENT}_{FIELD}, all uppercase.
# Hyphens in game names become underscores. Fields match the key names in
# games/<game>/environments/<env>.json under `server_infrastructure`.
#
# An explicitly-empty value is treated as "no value" (e.g. server with no
# password). A variable that is *unset* (commented out, missing) will cause
# the scripts to exit with an error — there is no fallback to a hardcoded
# default. Comment out the block for any game you don't deploy.

# --- Palworld ---
PALWORLD_PRODUCTION_ADMIN_PASSWORD=
PALWORLD_PRODUCTION_BASE_PASSWORD=
PALWORLD_STAGING_ADMIN_PASSWORD=
PALWORLD_STAGING_BASE_PASSWORD=

# --- ARK Survival Ascended ---
ARK_PRODUCTION_ADMIN_PASSWORD=
ARK_PRODUCTION_BASE_PASSWORD=
ARK_STAGING_ADMIN_PASSWORD=
ARK_STAGING_BASE_PASSWORD=

# --- PixARK ---
PIXARK_PRODUCTION_ADMIN_PASSWORD=
PIXARK_PRODUCTION_BASE_PASSWORD=
PIXARK_PRODUCTION_SFT_PASS=
PIXARK_STAGING_ADMIN_PASSWORD=
PIXARK_STAGING_BASE_PASSWORD=
PIXARK_STAGING_SFT_PASS=

# --- Smalland ---
# EOS client_secret and private_key are secrets; deployment_id and client_id
# identify the Epic Online Services app and are kept in the env JSON.
SMALLAND_PRODUCTION_BASE_PASSWORD=
SMALLAND_PRODUCTION_EOS_CLIENT_SECRET=
SMALLAND_PRODUCTION_EOS_PRIVATE_KEY=
SMALLAND_STAGING_BASE_PASSWORD=
SMALLAND_STAGING_EOS_CLIENT_SECRET=
SMALLAND_STAGING_EOS_PRIVATE_KEY=

# --- Windrose ---
# invite_code is a 6+ alphanumeric shared secret used to join the server.
WINDROSE_PRODUCTION_BASE_PASSWORD=
WINDROSE_PRODUCTION_INVITE_CODE=
WINDROSE_STAGING_BASE_PASSWORD=
WINDROSE_STAGING_INVITE_CODE=

# --- Minecraft ---
MINECRAFT_PRODUCTION_RCON_PASSWORD=
MINECRAFT_STAGING_RCON_PASSWORD=
